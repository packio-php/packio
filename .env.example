# Database
DEFAULT_DB_CONNECTION=postgres
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_NAME=packio
DATABASE_USER=postgresql
DATABASE_PASS=password

# Application
APP_NAME=Packio
APP_DEBUG=true
APP_PRODUCTION=false
APP_URL=http://packio.localhost:8080
APP_HEALTHCHECK_URL=http://localhost:80/health
APP_TIMEZONE=UTC
APP_SECRET_ENCRYPTION_KEY=
VALINOR_CACHE_DIR=
VALINOR_CACHE_WATCH=false

# HTTP CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://packio.localhost:8080,http://localhost:5173
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-API-TOKEN,X-Inertia,X-Inertia-Version,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Disposition,Location,Retry-After,WWW-Authenticate,X-Inertia,X-Inertia-Location,X-Inertia-Version
CORS_ALLOWED_MAX_AGE=600
CORS_CREDENTIALS_ALLOWED=false

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_FLUSH_ON_HTTP_ERROR=false
SENTRY_FLUSH_TIMEOUT=2
SENTRY_CAPTURE_CONSOLE_INPUT=false

# Mail (SMTP)
MAIL_DSN=
MAIL_SCHEME=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@packio.localhost
MAIL_FROM=noreply@packio.localhost
MAIL_FROM_NAME=Packio

# OAuth — user login via third-party providers
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=
OAUTH_GITHUB_SCOPES=read:user,user:email
OAUTH_GITHUB_SOURCE_SCOPES=read:user,user:email,repo,read:org
# Empty source redirect URL uses ${APP_URL}/auth/oauth/github/source-callback.
OAUTH_GITHUB_SOURCE_ENABLED=false
OAUTH_GITHUB_SOURCE_CLIENT_ID=
OAUTH_GITHUB_SOURCE_CLIENT_SECRET=
OAUTH_GITHUB_SOURCE_REDIRECT_URL=
OAUTH_GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
OAUTH_GITHUB_USER_URL=https://api.github.com/user
OAUTH_GITLAB_ENABLED=false
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_GITLAB_REDIRECT_URL=
OAUTH_GITLAB_SCOPES=read_user,openid,profile
OAUTH_GITLAB_SOURCE_SCOPES=read_user,api,read_repository
# Empty source redirect URL uses ${APP_URL}/auth/oauth/gitlab/source-callback.
OAUTH_GITLAB_SOURCE_ENABLED=false
OAUTH_GITLAB_SOURCE_CLIENT_ID=
OAUTH_GITLAB_SOURCE_CLIENT_SECRET=
OAUTH_GITLAB_SOURCE_REDIRECT_URL=
OAUTH_GITLAB_AUTHORIZATION_URL=
OAUTH_GITLAB_TOKEN_URL=
OAUTH_GITLAB_USER_URL=
OAUTH_GITLAB_BASE_URL=https://gitlab.com
OAUTH_GITLAB_SELF_HOSTED_SOURCE_ENABLED=false
# Bitbucket is reserved for a future implementation and is not currently exposed.
OAUTH_BITBUCKET_ENABLED=false
OAUTH_BITBUCKET_CLIENT_ID=
OAUTH_BITBUCKET_CLIENT_SECRET=
OAUTH_BITBUCKET_REDIRECT_URL=
OAUTH_BITBUCKET_SCOPES=
OAUTH_BITBUCKET_SOURCE_SCOPES=account,email,repository,webhook
# Empty source redirect URL uses ${APP_URL}/auth/oauth/bitbucket/source-callback.
OAUTH_BITBUCKET_SOURCE_ENABLED=false
OAUTH_BITBUCKET_SOURCE_CLIENT_ID=
OAUTH_BITBUCKET_SOURCE_CLIENT_SECRET=
OAUTH_BITBUCKET_SOURCE_REDIRECT_URL=
OAUTH_CODEBERG_ENABLED=false
OAUTH_CODEBERG_CLIENT_ID=
OAUTH_CODEBERG_CLIENT_SECRET=
OAUTH_CODEBERG_REDIRECT_URL=
OAUTH_CODEBERG_SCOPES=
OAUTH_CODEBERG_SOURCE_SCOPES=
# Empty source redirect URL uses ${APP_URL}/auth/oauth/codeberg/source-callback.
OAUTH_CODEBERG_SOURCE_ENABLED=false
OAUTH_CODEBERG_SOURCE_CLIENT_ID=
OAUTH_CODEBERG_SOURCE_CLIENT_SECRET=
OAUTH_CODEBERG_SOURCE_REDIRECT_URL=
OAUTH_CODEBERG_AUTHORIZATION_URL=
OAUTH_CODEBERG_TOKEN_URL=
OAUTH_CODEBERG_USER_URL=
OAUTH_CODEBERG_BASE_URL=https://codeberg.org

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_HOSTNAME=
TURNSTILE_VALIDATE_HOSTNAME=true

# Branding
BRAND_PRODUCT_NAME=Packio
BRAND_TAGLINE='Lightweight private package registry for Composer'
BRAND_DOMAIN=packio.localhost
BRAND_REGISTRY_BASE_DOMAIN=packio.localhost
BRAND_SHORT_NAME=packio
BRAND_COMPOSER_REPOSITORY_ALIAS=packio
BRAND_REGISTRY_TOKEN_PREFIX=packio_rt_
BRAND_REGISTRY_AUTH_REALM=Packio
BRAND_HTTP_USER_AGENT=Packio/0.1
BRAND_THEME_STORAGE_KEY=packio-theme

# Features
IDENTITY_REGISTRATION_OPEN=true
SOURCE_PROVIDER_GITHUB_ENABLED=true
SOURCE_PROVIDER_GITLAB_ENABLED=true
SOURCE_PROVIDER_GITLAB_SELF_HOSTED_ENABLED=true
SOURCE_PROVIDER_GENERIC_GIT_ENABLED=true
SOURCE_PROVIDER_BITBUCKET_ENABLED=true
SOURCE_PROVIDER_CODEBERG_ENABLED=true
VITE_DEV_SERVER_URL=http://localhost:5173
SERVER_NAME='packio.localhost:80, *.packio.localhost:80, localhost:80, *.localhost:80'
WORKER_TIMEOUT=30
WORKER_MEMORY_LIMIT=512M
WORKER_MAX_JOBS=100
WORKER_ID=
# RoadRunner HTTP pool (used only with compose.roadrunner.yaml)
RR_NUM_WORKERS=2
RR_MAX_JOBS=500
RR_MAX_QUEUE_SIZE=256
RR_MAX_WORKER_MEMORY_MB=256
RR_ALLOCATE_TIMEOUT=60s
RR_DESTROY_TIMEOUT=60s
RR_EXEC_TTL=60s
RR_RELAY_TIMEOUT=60s
RR_MAX_REQUEST_SIZE_MB=32
WORKER_CLEANUP_INTERVAL_SECONDS=3600
WORKER_CLEANUP_RETENTION_DAYS=30
EMAIL_VERIFICATION_CLEANUP_INTERVAL_SECONDS=3600
PASSWORD_RESET_CLEANUP_INTERVAL_SECONDS=3600
PACKIO_DOCKER_UID=1000
PACKIO_DOCKER_GID=1000

# Security
TRUSTED_PROXIES=
APP_RATE_LIMIT_DIR=data/rate-limits
# Unset = maximum effective policy/route window (at least the CSRF log window, 300s).
# Before cleanup, explicitly cover all historical windows; see docs/rate-limiting.md.
# RATE_LIMIT_RETENTION_SECONDS=3600
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_DECAY=3600
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_DECAY=60
RATE_LIMIT_REGISTRY_AUTH_MAX=30
RATE_LIMIT_REGISTRY_AUTH_DECAY=60
RATE_LIMIT_EMAIL_VERIFICATION_SEND_MAX=3
RATE_LIMIT_EMAIL_VERIFICATION_SEND_DECAY=900
RATE_LIMIT_EMAIL_VERIFICATION_VERIFY_MAX=5
RATE_LIMIT_EMAIL_VERIFICATION_VERIFY_DECAY=600
RATE_LIMIT_EMAIL_VERIFICATION_RESEND_MAX=3
RATE_LIMIT_EMAIL_VERIFICATION_RESEND_DECAY=1800
RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX=3
RATE_LIMIT_PASSWORD_RESET_REQUEST_DECAY=900
RATE_LIMIT_PASSWORD_RESET_SUBMIT_MAX=5
RATE_LIMIT_PASSWORD_RESET_SUBMIT_DECAY=900
RATE_LIMIT_PASSWORD_CHANGE_MAX=5
RATE_LIMIT_PASSWORD_CHANGE_DECAY=900
RATE_LIMIT_OAUTH_EMAIL_MAX=5
RATE_LIMIT_OAUTH_EMAIL_DECAY=900

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DIR=data/logs
LOG_PATH=
LOG_DAILY_DAYS=14
LOG_FILE_PERMISSION=0664

# Resource limits for untrusted requests and provider operations
WEBHOOK_MAX_BYTES=1048576
REQUEST_MAX_BYTES=33554432
UPSTREAM_MAX_BYTES=16777216
GIT_TIMEOUT_SECONDS=120
GIT_WORKSPACE_MAX_BYTES=1073741824

# Maximum address space per Git subprocess (512 MiB)
GIT_MEMORY_MAX_BYTES=536870912
