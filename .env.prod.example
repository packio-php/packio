# Copy to .env.prod.local. Never commit the filled-in file.
APP_DEBUG=false
APP_PRODUCTION=true
APP_URL=https://packio.example.com
BRAND_DOMAIN=packio.example.com
BRAND_REGISTRY_BASE_DOMAIN=packio.example.com
CORS_ALLOWED_ORIGINS=https://packio.example.com
HTTP_PORT=8080
PACKIO_IMAGE_TAG=local
DEFAULT_DB_CONNECTION=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=packio
DATABASE_USER=packio
DATABASE_PASS=
# Generate: openssl rand -base64 32; prefix the result with base64:
APP_SECRET_ENCRYPTION_KEY=
# Host Caddy only: match these edge routes to APP_URL and
# BRAND_REGISTRY_BASE_DOMAIN. Supply a pre-provisioned certificate covering the
# app host and *.<registry-domain>; Caddy does not provision it automatically.
PACKIO_APP_DOMAIN=packio.example.com
PACKIO_REGISTRY_DOMAIN=packio.example.com
PACKIO_HTTPS_PORT=443
PACKIO_EDGE_BIND=0.0.0.0
PACKIO_TLS_CERT=/etc/ssl/packio/fullchain.pem
PACKIO_TLS_KEY=/etc/ssl/packio/privkey.pem
# Must match HTTP_PORT above; this controls only the host-side Caddy upstream.
PACKIO_HTTP_UPSTREAM=127.0.0.1:8080
# Set to the exact measured Caddy peer IP/CIDR visible inside the app container.
# A production Docker bridge gateway may be this peer; do not use a guessed IP or *.
TRUSTED_PROXIES=
MAIL_DSN=smtps://user:password@smtp.example.com:465
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Packio
# compose.prod.yaml runs migrations and the runtime-settings seed in app startup
# with RUN_MIGRATIONS=true; workers and SSR have it disabled.
RR_NUM_WORKERS=2
RR_MAX_JOBS=500
RR_MAX_WORKER_MEMORY_MB=256
# Queue consumers managed by RoadRunner service; maintenance processes stay at one each.
PACKIO_WORKER_NUM=7
WORKER_TIMEOUT=30
WORKER_MEMORY_LIMIT=512M
WORKER_MAX_JOBS=100
