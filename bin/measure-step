#!/bin/sh

set -eu

if [ "$#" -lt 2 ]; then
    printf '%s\n' 'Usage: bin/measure-step <label> <command> [arguments...]' >&2
    exit 2
fi

label=$1
shift
started_at=$(date +%s)

if "$@"; then
    status=0
else
    status=$?
fi

finished_at=$(date +%s)
printf '[timing] %s: %s s\n' "$label" "$((finished_at - started_at))" >&2

exit "$status"
