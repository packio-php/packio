#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: bin/with-postgres-test <command> [arguments...]' >&2
    exit 2
fi

project_root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
cd "$project_root"

test_service_started=false

runner_mode=${PACKIO_TEST_RUNNER_MODE:-}
if [ -z "$runner_mode" ]; then
    if [ -n "${CI:-}" ] && [ "${CI:-}" != 'false' ]; then
        runner_mode=ci
    elif [ -n "${FORGEJO_ACTIONS:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ] || [ -n "${GITLAB_CI:-}" ]; then
        runner_mode=ci
    else
        runner_mode=local
    fi
fi

failure_message() {
    printf '%s\n' "$1" >&2
    printf '%s\n' 'Recovery: docker compose --profile test up -d postgres-test' >&2
    printf '%s\n' 'Logs: docker compose --profile test logs postgres-test' >&2
    exit 1
}

stop_local_test_service() {
    status=$?

    if [ "$runner_mode" = 'local' ] && [ "$test_service_started" = true ]; then
        if ! docker compose --profile test stop postgres-test; then
            printf '%s\n' 'Warning: the isolated PostgreSQL test service could not be stopped.' >&2
        fi
    fi

    trap - EXIT
    exit "$status"
}

trap stop_local_test_service EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

case "$runner_mode" in
    local)
        : "${PACKIO_TEST_DATABASE_PORT:=15433}"
        : "${PACKIO_TEST_DATABASE_NAME:=packio_test}"
        : "${PACKIO_TEST_DATABASE_USER:=packio_test}"
        : "${PACKIO_TEST_DATABASE_PASS:=packio_test}"
        PACKIO_TEST_DATABASE_HOST=127.0.0.1
        export PACKIO_TEST_DATABASE_HOST PACKIO_TEST_DATABASE_PORT PACKIO_TEST_DATABASE_NAME PACKIO_TEST_DATABASE_USER PACKIO_TEST_DATABASE_PASS

        if ! command -v docker >/dev/null 2>&1; then
            failure_message 'Docker is required for the local PostgreSQL test runner.'
        fi

        if ! docker compose version >/dev/null 2>&1; then
            failure_message 'Docker Compose is required for the local PostgreSQL test runner.'
        fi

        if ! docker compose --profile test up -d postgres-test; then
            failure_message 'The isolated PostgreSQL test service could not be started.'
        fi

        test_service_started=true

        timeout_seconds=60
        started_at=$(date +%s)
        while :; do
            if docker compose --profile test exec -T postgres-test pg_isready \
                -h 127.0.0.1 \
                -p 5432 \
                -U "$PACKIO_TEST_DATABASE_USER" \
                -d "$PACKIO_TEST_DATABASE_NAME" >/dev/null 2>&1; then
                break
            fi

            if [ "$(( $(date +%s) - started_at ))" -ge "$timeout_seconds" ]; then
                failure_message 'The isolated PostgreSQL test service did not become ready within 60 seconds.'
            fi

            sleep 1
        done
        ;;
    ci)
        if [ -z "${PACKIO_TEST_DATABASE_HOST:-}" ] || [ -z "${PACKIO_TEST_DATABASE_PORT:-}" ] || [ -z "${PACKIO_TEST_DATABASE_NAME:-}" ] || [ -z "${PACKIO_TEST_DATABASE_USER:-}" ] || [ -z "${PACKIO_TEST_DATABASE_PASS:-}" ]; then
            printf '%s\n' 'CI PostgreSQL test runner requires PACKIO_TEST_DATABASE_HOST, PACKIO_TEST_DATABASE_PORT, PACKIO_TEST_DATABASE_NAME, PACKIO_TEST_DATABASE_USER and PACKIO_TEST_DATABASE_PASS.' >&2
            exit 1
        fi

        if ! command -v pg_isready >/dev/null 2>&1; then
            printf '%s\n' 'CI PostgreSQL test runner requires pg_isready to validate the service.' >&2
            exit 1
        fi

        if ! PGPASSWORD="$PACKIO_TEST_DATABASE_PASS" pg_isready \
            -h "$PACKIO_TEST_DATABASE_HOST" \
            -p "$PACKIO_TEST_DATABASE_PORT" \
            -U "$PACKIO_TEST_DATABASE_USER" \
            -d "$PACKIO_TEST_DATABASE_NAME"; then
            printf '%s\n' 'The configured CI PostgreSQL test service is not reachable.' >&2
            exit 1
        fi
        ;;
    *)
        printf 'Unsupported PACKIO_TEST_RUNNER_MODE: %s\n' "$runner_mode" >&2
        exit 2
        ;;
esac

export PACKIO_TEST_DB=postgres
export DEFAULT_DB_CONNECTION=postgres
export DATABASE_HOST="$PACKIO_TEST_DATABASE_HOST"
export DATABASE_PORT="$PACKIO_TEST_DATABASE_PORT"
export DATABASE_NAME="$PACKIO_TEST_DATABASE_NAME"
export DATABASE_USER="$PACKIO_TEST_DATABASE_USER"
export DATABASE_PASS="$PACKIO_TEST_DATABASE_PASS"
unset SQLITE_DATABASE

set +e
"$@"
command_status=$?
set -e

exit "$command_status"
