# Copy to .env and fill in the four values below. Never commit .env.

# Keeps the ":" separator on Windows too.
COMPOSE_PATH_SEPARATOR=:
# Which variant to run. Pick one line:
COMPOSE_FILE=compose.yaml
# COMPOSE_FILE=compose.yaml:compose.ssr.yaml    # plus server-side rendering
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml  # bundled HTTPS proxy with automatic certificates
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml:compose.ssr.yaml  # both

# Pin the release you downloaded (PACKIO_VERSION=X.Y.Z) so upgrades happen when you choose.
PACKIO_VERSION=latest

# The domain users open, without scheme (packio.example.com).
# Organization registries are served from <org>.<this domain>.
PACKIO_DOMAIN=

# Generate: openssl rand -hex 32
DATABASE_PASS=

# Generate: echo "base64:$(openssl rand -base64 32)"
# Losing this key makes stored secrets unreadable; back it up.
APP_SECRET_ENCRYPTION_KEY=

# Outgoing mail, for example smtps://user:password@smtp.example.com:465
MAIL_DSN=

# Required with your own reverse proxy (the Caddy overlay sets it itself): the proxy's IP as the app sees it. Without it every form (sign-in, registration) fails the CSRF origin check and all clients share one rate limit.
# TRUSTED_PROXIES=

# Optional:
# MAIL_FROM_ADDRESS=noreply@example.com
# HTTP_PORT=8080
# PACKIO_WORKER_NUM=7
# Caddy overlay: contact address for certificate expiry notices.
# ACME_EMAIL=admin@example.com
# Caddy overlay: subnet of the private network between Caddy and the app.
# PACKIO_EDGE_SUBNET=172.30.255.0/29
# Caddy overlay: Caddy's address in that subnet; the app trusts forwarded headers only from it.
# PACKIO_EDGE_PROXY_IP=172.30.255.2
# Caddy overlay: registries live at <org>.<this domain>; defaults to PACKIO_DOMAIN.
# BRAND_REGISTRY_BASE_DOMAIN=
# More settings: ENV.md
