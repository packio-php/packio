# Local trial only. Never use these values on a server.
# Copy to .env, run `docker compose up -d`, open http://packio.localhost:8080.
# Mails arrive in Mailpit at http://localhost:8025.
COMPOSE_FILE=compose.yaml:compose.local.yaml
# With server-side rendering: COMPOSE_FILE=compose.yaml:compose.local.yaml:compose.ssr.yaml
# Keeps the ":" separator on Windows too.
COMPOSE_PATH_SEPARATOR=:
PACKIO_VERSION=latest
PACKIO_DOMAIN=packio.localhost
DATABASE_PASS=local-trial-password
APP_SECRET_ENCRYPTION_KEY=base64:bG9jYWwtdHJpYWwtb25seS1rZXktaXMtMzItYnl0ZXM=
MAIL_DSN=smtp://mailpit:1025
